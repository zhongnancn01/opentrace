#!/usr/bin/env bash
set -euo pipefail
GRADLE_VERSION="9.6.0"
GRADLE_USER_HOME="${GRADLE_USER_HOME:-$HOME/.gradle}"
GRADLE_HOME="$GRADLE_USER_HOME/hoptrace-distributions/gradle-$GRADLE_VERSION"
if [[ -x "$GRADLE_HOME/bin/gradle" ]]; then
  exec "$GRADLE_HOME/bin/gradle" "$@"
fi
if command -v gradle >/dev/null 2>&1; then
  exec gradle "$@"
fi
mkdir -p "$GRADLE_USER_HOME/hoptrace-distributions"
ARCHIVE="$GRADLE_USER_HOME/hoptrace-distributions/gradle-$GRADLE_VERSION-bin.zip"
if [[ ! -f "$ARCHIVE" ]]; then
  echo "Downloading Gradle $GRADLE_VERSION..."
  curl -fL "https://services.gradle.org/distributions/gradle-$GRADLE_VERSION-bin.zip" -o "$ARCHIVE"
fi
unzip -q "$ARCHIVE" -d "$GRADLE_USER_HOME/hoptrace-distributions"
exec "$GRADLE_HOME/bin/gradle" "$@"
